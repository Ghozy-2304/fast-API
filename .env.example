APP_NAME="FastAPI AI Chatbot"
APP_ENV="development"
DEBUG=True
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:3000,https://jhic-20-production.up.railway.app"

