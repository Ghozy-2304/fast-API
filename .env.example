APP_NAME="FastAPI AI Chatbot"
APP_ENV="development"
DEBUG=True
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:3000,https://jhic-20-production.up.railway.app"

# Internal Security (Opsional: Kosongkan jika tidak ingin proteksi API Key di endpoint)
INTERNAL_API_KEY="your-secret-internal-api-key-here"

# OpenRouter Credentials & Config (Gemini 3.8 Flash)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"
OPENROUTER_MODEL="google/gemini-3.8-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SYSTEM_INSTRUCTIONS="You are a helpful and polite AI assistant."
